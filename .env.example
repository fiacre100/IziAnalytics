# Configuration IziAnalytics
# Remplacez par vos véritables clés lorsque vous créez votre projet Supabase & Google AI Studio

# 1. Supabase (Base de données & Auth - Gratuit sur https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-secrete

# 2. Google AI Studio (API Gemini 1.5 Flash - Gratuit sur https://aistudio.google.com)
GEMINI_API_KEY=votre-cle-gemini-gratuite
